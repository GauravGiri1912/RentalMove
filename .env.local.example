# ==========================================
# RentalMove — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<YOUR_PROJECT>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                  # public anon key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                       # SECRET — never expose client-side

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Get these from: https://console.cloudinary.com/settings/api-keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name     # also needed client-side for upload URL
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abc123...                        # SECRET
CLOUDINARY_NOTIFICATION_URL=https://your-domain.com/api/cloudinary/webhook

# ─── AI / Vision ──────────────────────────────────────────────────────────────
# VISION_PROVIDER: "groq" (real AI) | "mock" (local testing)
VISION_PROVIDER=groq
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Groq API Key — get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...                                   # SECRET

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000              # Use https://your-domain.com in production

# ─── Dev Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to force JSON file-based mock database (bypasses Supabase)
DEVELOPMENT_MOCK_MODE=false
