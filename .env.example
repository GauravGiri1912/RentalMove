# ==========================================
# RentalMove Environment Configuration
# Hackathon: Pixels to Products 2026 (Track 1)
# ==========================================

# --- Cloudinary Settings ---
# Found in your Cloudinary Dashboard: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_NOTIFICATION_URL=

# --- Vision & AI Provider Settings ---
# Options: 'mock' (default offline resilience), 'groq' (uses Qwen Vision 'qwen/qwen3.8-27b')
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b

# AI API Key (Groq / xAI)
GROQ_API_KEY=
XAI_API_KEY=

# --- Supabase Settings (Server / Client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEVELOPMENT_MOCK_MODE=false

# --- Optional ---
# Supabase is the single source of truth when configured. Set to "true" ONLY for local
# experiments to also keep a JSON copy and fall back to it (does not work on read-only hosts).
ENABLE_LOCAL_FALLBACK=
# Path of the local JSON store used in mock mode (tests point this at a temp file).
RENTALMOVE_STORE_PATH=

# Named Cloudinary transformations (t_rm_*); set to 0 to emit raw transformation strings
NEXT_PUBLIC_CLOUDINARY_NAMED=1
# Secret for phone-handoff tokens (any long random string)
HANDOFF_SECRET=
