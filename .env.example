# ==========================================
# RentalMove Environment Configuration
# Hackathon: Pixels to Products 2026 (Track 1)
# ==========================================

# --- Cloudinary Settings ---
# Found in your Cloudinary Dashboard: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_NOTIFICATION_URL=

# --- Vision & AI Provider Settings ---
# Options: 'mock' (default offline resilience), 'groq' (uses Qwen Vision 'qwen/qwen3.8-27b')
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b

# AI API Key (Groq / xAI)
GROQ_API_KEY=
XAI_API_KEY=

# --- Supabase Settings (Server / Client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEVELOPMENT_MOCK_MODE=false

