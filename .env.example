# ==========================================
# RentalMove Environment Configuration
# Hackathon: Pixels to Products 2026 (Track 1)
# ==========================================

# --- Cloudinary Settings ---
# Found in your Cloudinary Dashboard: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional webhook notification URL for upload notifications
CLOUDINARY_NOTIFICATION_URL=http://localhost:3000/api/cloudinary/webhook

# --- Vision Provider Settings ---
# Options: 'mock' (default offline), 'gemini', 'anthropic'
VISION_PROVIDER=mock
# e.g., 'gemini-2.0-flash', 'gemini-1.5-pro', 'claude-3-5-sonnet-20241022'
VISION_MODEL=mock-vlm-v1

# API Keys for live Vision Providers (required only when VISION_PROVIDER != mock)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Supabase Settings (Optional for offline demo) ---
# When omitted, RentalMove uses the in-memory SQLite/JSON store fallback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
