# ==========================================
# RentalMove Environment Configuration
# Hackathon: Pixels to Products 2026 (Track 1)
# ==========================================

# --- Cloudinary Settings ---
# Found in your Cloudinary Dashboard: https://console.cloudinary.com/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional webhook notification URL for upload notifications
CLOUDINARY_NOTIFICATION_URL=http://localhost:3000/api/cloudinary/webhook

# --- Vision & AI Provider Settings ---
# Options: 'mock' (default offline resilience), 'groq'
VISION_PROVIDER=mock
VISION_MODEL=mock-vlm-v1

# AI API Key (Groq / xAI)
GROQ_API_KEY=
XAI_API_KEY=

# --- Supabase Settings (Server / Client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
